# 监听地址与端口（生产环境由 Nginx 反向代理 /user-api/）
USER_SYNC_HOST=127.0.0.1
USER_SYNC_PORT=3002

# SQLite 数据库路径（启动时自动创建父目录并开启 WAL 模式）
USER_SYNC_DB_PATH=/data/user-sync/users.db

# 会话签名密钥（生产环境建议显式配置；若留空则自动生成并持久化到同目录 .secret 文件）
USER_SYNC_SECRET=

# 会员开关（默认 false：全部功能免费开放；仅预埋底层数据结构与管理端）
MEMBERSHIP_ENABLED=false

# 是否强制 Cookie 带 Secure 属性（反代传 X-Forwarded-Proto: https 时也会自动开启）
COOKIE_SECURE=0

# 可选：首次启动自动初始化管理员账号（若用户名已存在则跳过）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 登录与注册接口频率限制（默认每 IP 每 15 分钟 20 次）
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

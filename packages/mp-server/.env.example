# 复制成 .env 后填写；不要把 .env 提交进仓库。

PORT=8787

# 小程序 AppID 和 AppSecret（小程序后台 → 开发管理 → 开发设置）
MP_APPID=
MP_SECRET=

# 会话令牌密钥，至少 32 个字符，可用 `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"` 生成。
# 更换后所有用户需要重新登录（小程序端会自动重新登录）。
SESSION_SECRET=
SESSION_TTL_SEC=604800

# OpenAI 兼容的模型接口，必须是有算法备案的国产模型
# DeepSeek：https://api.deepseek.com  模型 deepseek-chat
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 豆包（火山方舟）：https://ark.cn-beijing.volces.com/api/v3  模型填推理接入点 ID
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000

# 每个用户每分钟最多几次优化、每天最多几次（北京时间 0 点重置）
RATE_LIMIT_PER_MIN=6
DAILY_QUOTA=50
# 单次输入最多多少字（提示词加改进方向）
MAX_INPUT_CHARS=3000
# 请求体上限（字节）和单个请求的总超时（毫秒）
MAX_BODY_BYTES=32768
REQUEST_TIMEOUT_MS=90000

# 本地开发：MP_DEV=1 跳过微信登录和内容安全检查；LLM_FAKE=1 不调用模型，返回固定格式的模拟结果
MP_DEV=0
LLM_FAKE=0

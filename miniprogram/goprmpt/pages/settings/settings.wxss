@import "../../styles/theme.wxss";

.field + .field {
  margin-top: 32rpx;
}

.hint {
  margin-top: 10rpx;
  font-size: var(--gp-font-xs);
}

.toggle {
  margin-bottom: 16rpx;
  font-size: var(--gp-font-sm);
}

.test-ok {
  padding: 24rpx;
  margin-bottom: var(--gp-gap);
  border-radius: var(--gp-radius-sm);
  background: var(--gp-primary-weak);
  color: var(--gp-success);
  font-size: var(--gp-font-sm);
}

.notes {
  margin-top: 40rpx;
}

.note {
  font-size: var(--gp-font-sm);
  color: var(--gp-text-2);
}

.note + .note {
  margin-top: 16rpx;
}

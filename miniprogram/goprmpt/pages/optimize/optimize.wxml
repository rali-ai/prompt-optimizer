<view class="gp-page">
  <view class="gp-row-between header">
    <view>
      <view class="gp-title">提示词优化</view>
      <view class="gp-muted">把想法改写成 AI 更容易理解的提示词</view>
    </view>
    <view class="gp-row">
      <view class="header-link" hover-class="gp-pressed" bindtap="onOpenHistory">历史</view>
      <view class="header-link" hover-class="gp-pressed" bindtap="onOpenSettings">设置</view>
    </view>
  </view>

  <view wx:if="{{!ready}}" class="gp-notice" hover-class="gp-pressed" bindtap="onOpenSettings">
    还没有设置模型和 API Key，点这里去设置 ›
  </view>

  <view class="gp-card">
    <view class="gp-row-between">
      <view class="gp-section-title">原始提示词</view>
      <view wx:if="{{input}}" class="gp-muted" hover-class="gp-pressed" bindtap="onClear">清空</view>
    </view>
    <textarea
      class="gp-textarea input"
      value="{{input}}"
      maxlength="-1"
      disable-default-padding="{{true}}"
      placeholder="粘贴或输入要优化的提示词，例如：帮我写一篇关于春天的公众号文章"
      placeholder-class="gp-placeholder"
      bindinput="onInput"
    />
    <view class="gp-muted count">{{input.length}} 字</view>
  </view>

  <view class="gp-card">
    <view class="gp-section-title">优化方式</view>
    <view class="gp-chips">
      <view
        wx:for="{{modes}}"
        wx:key="id"
        class="gp-chip {{item.id === modeId ? 'gp-chip-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickMode"
      >{{item.name}}</view>
    </view>
    <view class="gp-muted">{{modeDesc}}</view>

    <view class="gp-section-title lang-title">输出语言</view>
    <view class="gp-segment">
      <view
        wx:for="{{languages}}"
        wx:key="id"
        class="gp-segment-item {{item.id === lang ? 'gp-segment-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickLang"
      >{{item.name}}</view>
    </view>
  </view>

  <view
    class="gp-btn gp-btn-primary {{phase !== 'idle' ? 'gp-btn-disabled' : ''}}"
    hover-class="gp-pressed"
    bindtap="onOptimize"
  >{{phase === 'optimizing' ? '优化中…' : '开始优化'}}</view>

  <view wx:if="{{error}}" class="gp-error error">
    <text class="gp-text">{{error}}</text>
    <view
      wx:if="{{errorKind === 'config' || errorKind === 'auth' || errorKind === 'not_found'}}"
      class="gp-link error-link"
      bindtap="onOpenSettings"
    >去设置 ›</view>
  </view>

  <view wx:if="{{result}}" id="result" class="gp-card result">
    <view class="gp-row-between result-head">
      <view class="gp-section-title result-title">优化结果 · 第 {{round}} 轮</view>
      <view class="gp-segment view-switch">
        <view class="gp-segment-item {{view === 'after' ? 'gp-segment-on' : ''}}" data-view="after" bindtap="onSwitchView">优化后</view>
        <view class="gp-segment-item {{view === 'compare' ? 'gp-segment-on' : ''}}" data-view="compare" bindtap="onSwitchView">前后对比</view>
      </view>
    </view>

    <view wx:if="{{view === 'after'}}" class="result-text">
      <text class="gp-text" user-select="{{true}}">{{result}}</text>
    </view>
    <view wx:else>
      <view class="gp-compare-label">优化前</view>
      <view class="gp-compare-box gp-compare-before">
        <text class="gp-text" user-select="{{true}}">{{before}}</text>
      </view>
      <view class="gp-compare-label">优化后</view>
      <view class="gp-compare-box gp-compare-after">
        <text class="gp-text" user-select="{{true}}">{{result}}</text>
      </view>
    </view>

    <view class="gp-actions result-actions">
      <view class="gp-btn" hover-class="gp-pressed" bindtap="onCopy">复制</view>
      <view class="gp-btn {{showIterate ? 'gp-chip-on' : ''}}" hover-class="gp-pressed" bindtap="onToggleIterate">再优化</view>
    </view>

    <view wx:if="{{showIterate}}" class="iterate">
      <textarea
        class="gp-textarea iterate-input"
        value="{{iterateInput}}"
        maxlength="-1"
        auto-height="{{true}}"
        disable-default-padding="{{true}}"
        placeholder="想怎么改？例如：更简洁、加上输出格式要求。可留空"
        placeholder-class="gp-placeholder"
        bindinput="onIterateInput"
      />
      <view
        class="gp-btn gp-btn-primary {{phase !== 'idle' ? 'gp-btn-disabled' : ''}}"
        hover-class="gp-pressed"
        bindtap="onIterate"
      >{{phase === 'iterating' ? '再优化中…' : '在这一版上再优化'}}</view>
    </view>
  </view>
</view>

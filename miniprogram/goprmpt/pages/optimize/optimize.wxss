@import "../../styles/theme.wxss";

.header {
  align-items: flex-start;
  margin-bottom: var(--gp-gap);
}

.header-link {
  margin-left: 28rpx;
  padding: 8rpx 0;
  color: var(--gp-primary);
  font-size: var(--gp-font-sm);
}

.input {
  height: 300rpx;
}

.count {
  margin-top: 12rpx;
  text-align: right;
  font-size: var(--gp-font-xs);
}

.lang-title {
  margin-top: 28rpx;
}

.error {
  margin-top: var(--gp-gap);
}

.error-link {
  margin-top: 12rpx;
}

.result {
  margin-top: var(--gp-gap);
}

.result-head {
  margin-bottom: 20rpx;
}

.result-title {
  margin-bottom: 0;
}

.view-switch .gp-segment-item {
  height: 52rpx;
  line-height: 52rpx;
  font-size: var(--gp-font-xs);
}

.result-text {
  font-size: var(--gp-font);
  line-height: 1.7;
}

.result-actions {
  margin-top: 28rpx;
}

.iterate {
  margin-top: 24rpx;
}

.iterate-input {
  min-height: 120rpx;
  margin-bottom: 20rpx;
}

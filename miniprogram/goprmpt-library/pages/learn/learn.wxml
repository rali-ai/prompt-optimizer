<view wx:if="{{t}}" class="gp-page">
  <view class="intro">
    <view class="gp-title">{{t.learn.title}}</view>
    <view class="gp-muted">{{t.learn.subtitle}}</view>
  </view>

  <view wx:if="{{!lessons.length}}" class="gp-empty">{{t.learn.empty}}</view>

  <view
    wx:for="{{lessons}}"
    wx:key="id"
    class="gp-card lesson"
    hover-class="gp-pressed"
    data-id="{{item.id}}"
    bindtap="onOpen"
  >
    <view class="lesson-title">{{item.title}}</view>
    <view wx:if="{{item.summary}}" class="gp-clamp-2 lesson-summary">{{item.summary}}</view>
  </view>
</view>

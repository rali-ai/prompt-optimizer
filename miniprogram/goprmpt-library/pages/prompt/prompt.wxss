.title {
  margin-top: 20rpx;
  font-size: var(--gp-font-xl);
  font-weight: 600;
  line-height: 1.35;
}

.summary {
  margin-top: 12rpx;
  color: var(--gp-text-2);
}

.tags {
  margin-top: 16rpx;
}

.credit {
  margin-top: 12rpx;
  font-size: var(--gp-font-xs);
  color: var(--gp-text-3);
}

.field + .field {
  margin-top: 28rpx;
}

.field-name {
  font-weight: 600;
}

.field-desc {
  margin: 4rpx 0 12rpx;
}

.field-input {
  min-height: 84rpx;
  margin-top: 8rpx;
}

.final {
  font-size: var(--gp-font);
  line-height: 1.7;
}

.hint {
  margin-top: 16rpx;
  font-size: var(--gp-font-xs);
}

.example {
  font-size: var(--gp-font-sm);
  color: var(--gp-text-2);
}

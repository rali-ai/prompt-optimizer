<view wx:if="{{missing}}" class="gp-empty">{{t.lesson.missing}}</view>

<view wx:elif="{{t}}" class="gp-page">
  <view class="head">
    <view class="gp-title">{{lesson.title}}</view>
    <view wx:if="{{lesson.summary}}" class="gp-muted summary">{{lesson.summary}}</view>
  </view>

  <view wx:for="{{sections}}" wx:for-item="section" wx:key="heading" class="gp-card">
    <view class="section-heading">{{section.heading}}</view>
    <view wx:for="{{section.blocks}}" wx:for-item="block" class="block block-{{block.type}}">
      <text class="gp-text" user-select="{{true}}">{{block.text}}</text>
    </view>
  </view>

  <view wx:if="{{lesson.before || lesson.after}}" class="gp-card">
    <view class="gp-section-title">{{t.lesson.compare}}</view>
    <block wx:if="{{lesson.before}}">
      <view class="gp-compare-label">{{t.lesson.before}}</view>
      <view class="gp-compare-box gp-compare-before">
        <text class="gp-text" user-select="{{true}}">{{lesson.before}}</text>
      </view>
    </block>
    <block wx:if="{{lesson.after}}">
      <view class="gp-compare-label">{{t.lesson.after}}</view>
      <view class="gp-compare-box gp-compare-after">
        <text class="gp-text" user-select="{{true}}">{{lesson.after}}</text>
      </view>
    </block>
  </view>

  <view wx:if="{{lesson.exercise}}" class="gp-card">
    <view class="gp-section-title">{{t.lesson.exercise}}</view>
    <text class="gp-text exercise" user-select="{{true}}">{{lesson.exercise}}</text>
    <view class="gp-btn gp-btn-primary practice" hover-class="gp-pressed" bindtap="onPractice">{{t.lesson.practice}}</view>
  </view>
</view>

.head {
  margin-bottom: 32rpx;
}

.summary {
  margin-top: 12rpx;
}

.section-heading {
  margin-bottom: 16rpx;
  font-size: var(--gp-font-lg);
  font-weight: 600;
}

.block + .block {
  margin-top: 16rpx;
}

.block-h {
  font-weight: 600;
}

.block-li {
  padding-left: 12rpx;
}

.block-quote {
  padding-left: 20rpx;
  border-left: 6rpx solid var(--gp-border);
  color: var(--gp-text-2);
}

.block-code {
  padding: 20rpx 24rpx;
  border-radius: var(--gp-radius-sm);
  background: var(--gp-surface-2);
  font-family: var(--gp-mono);
  font-size: var(--gp-font-sm);
}

.exercise {
  color: var(--gp-text-2);
}

.practice {
  margin-top: 28rpx;
}

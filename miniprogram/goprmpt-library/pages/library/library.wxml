<view class="gp-page">
  <input
    class="gp-input search"
    value="{{query}}"
    placeholder="搜索标题、用途或标签"
    placeholder-class="gp-placeholder"
    confirm-type="search"
    bindinput="onSearch"
  />

  <view class="gp-row-between filters">
    <view class="gp-segment">
      <view
        wx:for="{{kinds}}"
        wx:key="id"
        class="gp-segment-item {{item.id === kind ? 'gp-segment-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickKind"
      >{{item.name}}</view>
    </view>
    <view class="gp-segment">
      <view
        wx:for="{{languages}}"
        wx:key="id"
        class="gp-segment-item {{item.id === lang ? 'gp-segment-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickLang"
      >{{item.name}}</view>
    </view>
  </view>

  <scroll-view scroll-x="{{true}}" class="categories">
    <view class="category-row">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="gp-chip {{item.id === categoryId ? 'gp-chip-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickCategory"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{!items.length}}" class="gp-empty">没有找到相关提示词</view>

  <view
    wx:for="{{items}}"
    wx:key="id"
    class="gp-card item"
    hover-class="gp-pressed"
    data-id="{{item.id}}"
    bindtap="onOpen"
  >
    <view class="gp-row-between">
      <view class="item-title">{{item.title}}</view>
      <view class="gp-tag target">{{item.targetLabel}}</view>
    </view>
    <view class="gp-clamp-2 item-summary">{{item.summary}}</view>
    <view wx:if="{{item.tags.length || item.fallback}}" class="tags">
      <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="gp-tag">{{tag}}</view>
      <view wx:if="{{item.fallback}}" class="gp-tag">暂无英文版</view>
    </view>
  </view>
</view>

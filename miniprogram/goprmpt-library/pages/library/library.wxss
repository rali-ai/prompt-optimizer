@import "../../styles/theme.wxss";

.search {
  background: var(--gp-surface);
}

.filters {
  margin: 24rpx 0 16rpx;
}

.filters .gp-segment {
  background: var(--gp-surface);
}

.filters .gp-segment-on {
  background: var(--gp-primary-weak);
  color: var(--gp-primary);
  box-shadow: none;
}

.categories {
  width: 100%;
  margin-bottom: 8rpx;
}

.category-row {
  white-space: nowrap;
}

.category-row .gp-chip {
  background: var(--gp-surface);
}

.category-row .gp-chip-on {
  background: var(--gp-primary-weak);
}

.item-title {
  font-size: var(--gp-font-lg);
  font-weight: 600;
  line-height: 1.4;
}

.target {
  flex-shrink: 0;
  margin: 0 0 0 16rpx;
}

.item-summary {
  margin-top: 8rpx;
  font-size: var(--gp-font-sm);
  color: var(--gp-text-2);
}

.tags {
  margin-top: 16rpx;
}

/*
 * goprmpt 主题。换肤只改下面 page 里的变量。
 * 外壳的 styles/theme.wxss 与简版的 goprmpt-lite/styles/theme.wxss 是逐字副本（简版要能单独拷走），
 * 改了一份要同步另一份（miniprogram/tools/check.mjs 会检查两份是否一致）。
 */
page {
  --gp-bg: #f5f6f8;
  --gp-surface: #ffffff;
  --gp-surface-2: #f0f2f5;
  --gp-text: #1d2129;
  --gp-text-2: #4e5969;
  --gp-text-3: #86909c;
  --gp-border: #e5e6eb;
  --gp-primary: #3a5ccc;
  --gp-primary-weak: #edf1fc;
  --gp-on-primary: #ffffff;
  --gp-danger: #c4382f;
  --gp-danger-weak: #fdeeed;
  --gp-warn-weak: #fff7e6;
  --gp-warn: #9a5b00;
  --gp-success: #23845b;
  --gp-radius: 20rpx;
  --gp-radius-sm: 12rpx;
  --gp-gap: 24rpx;
  --gp-pad: 32rpx;
  --gp-font: 30rpx;
  --gp-font-sm: 26rpx;
  --gp-font-xs: 22rpx;
  --gp-font-lg: 34rpx;
  --gp-font-xl: 44rpx;
  --gp-mono: Menlo, Consolas, monospace;
  background-color: var(--gp-bg);
  color: var(--gp-text);
  font-size: var(--gp-font);
  line-height: 1.6;
}

.gp-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--gp-pad) var(--gp-pad) calc(var(--gp-pad) * 2 + env(safe-area-inset-bottom));
}

.gp-card {
  background: var(--gp-surface);
  border-radius: var(--gp-radius);
  padding: var(--gp-pad);
  margin-bottom: var(--gp-gap);
}

.gp-title {
  font-size: var(--gp-font-xl);
  font-weight: 600;
  line-height: 1.3;
}

.gp-section-title {
  font-size: var(--gp-font-sm);
  font-weight: 600;
  color: var(--gp-text-2);
  margin-bottom: 16rpx;
}

.gp-muted {
  font-size: var(--gp-font-sm);
  color: var(--gp-text-3);
}

.gp-link {
  color: var(--gp-primary);
}

.gp-row {
  display: flex;
  align-items: center;
}

.gp-row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gp-chips {
  display: flex;
  flex-wrap: wrap;
}

.gp-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: var(--gp-surface-2);
  color: var(--gp-text-2);
  font-size: var(--gp-font-sm);
  line-height: 1.5;
}

.gp-chip-on {
  background: var(--gp-primary-weak);
  color: var(--gp-primary);
  font-weight: 600;
}

.gp-segment {
  display: flex;
  padding: 6rpx;
  border-radius: var(--gp-radius-sm);
  background: var(--gp-surface-2);
}

.gp-segment-item {
  flex: 1;
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  white-space: nowrap;
  border-radius: 8rpx;
  color: var(--gp-text-2);
  font-size: var(--gp-font-sm);
}

.gp-segment-on {
  background: var(--gp-surface);
  color: var(--gp-text);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.gp-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--gp-radius);
  background: var(--gp-surface-2);
  color: var(--gp-text);
  font-size: var(--gp-font);
}

.gp-btn-primary {
  background: var(--gp-primary);
  color: var(--gp-on-primary);
  font-weight: 600;
}

.gp-btn-small {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: var(--gp-radius-sm);
  font-size: var(--gp-font-sm);
}

.gp-btn-disabled {
  opacity: 0.55;
}

.gp-pressed {
  opacity: 0.7;
}

.gp-actions {
  display: flex;
}

.gp-actions .gp-btn {
  flex: 1;
}

.gp-actions .gp-btn + .gp-btn {
  margin-left: 20rpx;
}

.gp-input,
.gp-textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: var(--gp-radius-sm);
  background: var(--gp-surface-2);
  color: var(--gp-text);
  font-size: var(--gp-font);
}

.gp-input {
  height: 84rpx;
  padding: 0 24rpx;
}

.gp-textarea {
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.gp-placeholder {
  color: var(--gp-text-3);
}

.gp-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.gp-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
  border-radius: 8rpx;
  background: var(--gp-surface-2);
  color: var(--gp-text-3);
  font-size: var(--gp-font-xs);
}

.gp-notice {
  padding: 20rpx 24rpx;
  margin-bottom: var(--gp-gap);
  border-radius: var(--gp-radius-sm);
  background: var(--gp-warn-weak);
  color: var(--gp-warn);
  font-size: var(--gp-font-sm);
}

.gp-error {
  padding: 24rpx;
  margin-bottom: var(--gp-gap);
  border-radius: var(--gp-radius-sm);
  background: var(--gp-danger-weak);
  color: var(--gp-danger);
  font-size: var(--gp-font-sm);
}

.gp-empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--gp-text-3);
  font-size: var(--gp-font-sm);
}

.gp-clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.gp-compare-label {
  margin: 24rpx 0 12rpx;
  font-size: var(--gp-font-xs);
  color: var(--gp-text-3);
}

.gp-compare-box {
  padding: 20rpx 24rpx;
  border-radius: var(--gp-radius-sm);
  font-size: var(--gp-font-sm);
}

.gp-compare-before {
  background: var(--gp-surface-2);
  color: var(--gp-text-2);
}

.gp-compare-after {
  background: var(--gp-primary-weak);
  color: var(--gp-text);
}

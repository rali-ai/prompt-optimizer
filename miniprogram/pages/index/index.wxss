.brand {
  padding: 48rpx 0 40rpx;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: var(--gp-primary);
  color: var(--gp-on-primary);
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
}

.brand-name {
  margin-bottom: 8rpx;
  font-size: var(--gp-font-xl);
  font-weight: 600;
}

.main {
  background: var(--gp-primary);
  color: var(--gp-on-primary);
}

.main-title {
  font-size: var(--gp-font-lg);
  font-weight: 600;
}

.main-desc {
  margin-top: 8rpx;
  font-size: var(--gp-font-sm);
  opacity: 0.85;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cell {
  box-sizing: border-box;
  width: calc(50% - 12rpx);
}

.cell-title {
  margin-bottom: 4rpx;
  font-size: var(--gp-font-lg);
  font-weight: 600;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--gp-font-xs);
}

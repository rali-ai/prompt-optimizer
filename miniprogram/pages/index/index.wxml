<view wx:if="{{t}}" class="gp-page">
  <view class="brand">
    <view class="logo">P</view>
    <view class="brand-name">goprmpt</view>
    <view class="gp-muted">{{t.index.tagline}}</view>
  </view>

  <view class="gp-card main" hover-class="gp-pressed" data-url="/goprmpt-lite/pages/optimize/optimize" bindtap="onOpen">
    <view class="main-title">{{t.index.start}}</view>
    <view class="main-desc">{{t.index.startDesc}}</view>
  </view>

  <view class="grid">
    <view class="gp-card cell" hover-class="gp-pressed" data-url="/goprmpt-library/pages/library/library" bindtap="onOpen">
      <view class="cell-title">{{t.index.library}}</view>
      <view class="gp-muted">{{t.index.libraryDesc}}</view>
    </view>
    <view class="gp-card cell" hover-class="gp-pressed" data-url="/goprmpt-library/pages/learn/learn" bindtap="onOpen">
      <view class="cell-title">{{t.index.learn}}</view>
      <view class="gp-muted">{{t.index.learnDesc}}</view>
    </view>
    <view class="gp-card cell" hover-class="gp-pressed" data-url="/goprmpt-lite/pages/history/history" bindtap="onOpen">
      <view class="cell-title">{{t.index.history}}</view>
      <view class="gp-muted">{{t.index.historyDesc}}</view>
    </view>
    <view class="gp-card cell" hover-class="gp-pressed" data-url="/goprmpt-lite/pages/settings/settings" bindtap="onOpen">
      <view class="cell-title">{{t.index.settings}}</view>
      <view class="gp-muted">{{t.index.settingsDesc}}</view>
    </view>
  </view>

  <view class="gp-muted footer">
    <text class="gp-link" data-url="/pages/about/about" bindtap="onOpen">{{t.index.about}}</text> · {{t.index.footer}}
  </view>
</view>
